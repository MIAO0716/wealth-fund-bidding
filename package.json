{
  "name": "wealth-fund-bidding",
  "private": true,
  "version": "0.1.0",
  "description": "理财、基金现场竞标系统",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "start": "npm run start -w apps/server",
    "db:migrate": "npm run db:migrate -w apps/server",
    "admin:create": "npm run admin:create -w apps/server --",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@playwright/test": "1.56.1"
  },
  "overrides": {
    "uuid": "11.1.1",
    "vite": "7.3.6"
  },
  "type": "module"
}
