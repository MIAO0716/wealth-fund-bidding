# 复制为 .env 后按实际环境修改。不要把 .env 提交到仓库。

# PostgreSQL 连接串
DATABASE_URL=postgres://bid:请改成强密码@localhost:5432/bidding

# 监听地址与端口
HOST=0.0.0.0
PORT=8080

# 对外访问地址：二维码里写的就是这个地址，必须是手机能访问到的地址
#   互联网部署：https://bid.example.com
#   会场局域网：http://192.168.1.10:8080（不能写 localhost）
PUBLIC_BASE_URL=http://192.168.1.10:8080

# HTTPS 部署时为 true（默认根据 PUBLIC_BASE_URL 是否 https 自动判断）
# COOKIE_SECURE=true

# 位于 Nginx 等反向代理之后时设为 true
TRUST_PROXY=false

# 前端构建产物目录（生产同域托管）；开发时留空，由 Vite 开发服务器提供页面
WEB_DIST=../web/dist

# 自动检查点目录：首轮发布、项目锁定后自动 pg_dump；留空则不自动备份
BACKUP_DIR=../../backups
# PG_DUMP_PATH=pg_dump

# 只读维护模式：恢复备份时设为 true，拒绝一切写入
READ_ONLY=false

LOG_LEVEL=info
ADMIN_SESSION_HOURS=12

# 测试数据库（npm test 使用，会被清空，切勿指向正式库）
TEST_DATABASE_URL=postgres://bid:bid@localhost:5432/bidding_test

# ---- docker compose 专用 ----
# 数据库密码（compose 会用它初始化 PostgreSQL）
DB_PASSWORD=请改成强密码
# 主机对外端口
APP_PORT=8080
